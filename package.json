{
  "name": "dsh-chrome-mcp",
  "version": "0.1.0",
  "description": "dsh plugin: Chrome DevTools MCP bridge (npx chrome-devtools-mcp) with Settings-editable flags on dsh 0.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "chrome",
    "chrome-devtools",
    "mcp"
  ],
  "author": "Janis Kroja",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
